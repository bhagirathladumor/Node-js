<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Admins - Admin Panel</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-shield-alt"></i> Admin Panel</h2>
        </div>
        <nav class="sidebar-menu">
            <div style="padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Pages</div>
            <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a href="/profile" class="<%= currentPath === '/profile' ? 'active' : '' %>">
                <i class="fas fa-user"></i> Profile
            </a>
            <a href="/viewAdmin" class="<%= currentPath === '/viewAdmin' ? 'active' : '' %>">
                <i class="fas fa-users"></i> Manage Admins
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Tools & Components</div>
            <a href="/addAdmin" class="<%= currentPath === '/addAdmin' ? 'active' : '' %>">
                <i class="fas fa-user-plus"></i> Add Admin
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Categories</div>
            <a href="/addCategory" class="<%= currentPath === '/addCategory' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Categories
            </a>
            <a href="/viewCategories" class="<%= currentPath === '/viewCategories' || currentPath.includes('/editCategory') ? 'active' : '' %>">
                <i class="fas fa-list"></i> All Categories
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Sub Categories</div>
            <a href="/addSubcategory" class="<%= currentPath === '/addSubcategory' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Sub Categories
            </a>
            <a href="/viewSubcategories" class="<%= currentPath === '/viewSubcategories' || currentPath.includes('/editSubcategory') ? 'active' : '' %>">
                <i class="fas fa-folder"></i> All Sub Categories
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Extra Categories</div>
            <a href="/addExtracategory" class="<%= currentPath === '/addExtracategory' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Extra Categories
            </a>
            <a href="/viewExtracategories" class="<%= currentPath === '/viewExtracategories' || currentPath.includes('/editExtracategory') ? 'active' : '' %>">
                <i class="fas fa-layer-group"></i> All Extra Categories
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Products</div>
            <a href="/addProduct" class="<%= currentPath === '/addProduct' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Product
            </a>
            <a href="/viewProducts" class="<%= currentPath === '/viewProducts' || currentPath.includes('/editProduct') ? 'active' : '' %>">
                <i class="fas fa-box"></i> All Products
            </a>
            
            <a href="/change-password" class="<%= currentPath === '/change-password' ? 'active' : '' %>" style="margin-top: 1rem;">
                <i class="fas fa-key"></i> Change Password
            </a>
            <a href="/logout" style="margin-top: 1rem; color: #ef4444;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <div class="header-left">
                <button id="sidebarToggle" class="btn btn-outline" style="display: none; margin-right: 1rem;">
                    <i class="fas fa-bars"></i>
                </button>
                <h1>View Admins</h1>
            </div>
            <div class="header-right">
                <div class="user-info">
                    <div class="user-avatar">
                        <% if (admin && admin.fname) { %>
                            <%= admin.fname.charAt(0).toUpperCase() %>
                        <% } else { %>
                            A
                        <% } %>
                    </div>
                    <div>
                        <div style="font-weight: 600;">
                            <% if (admin && admin.fname && admin.lname) { %>
                                <%= admin.fname %> <%= admin.lname %>
                            <% } else { %>
                                Admin User
                            <% } %>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-secondary);">Administrator</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Content -->
        <div class="content">
            <div class="card">
                <div class="card-header d-flex justify-between align-center">
                    <h3>All Administrators</h3>
                    <a href="/addAdmin" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i> Add New Admin
                    </a>
                </div>
                <div class="card-body">
                    <% if (allAdmin.length > 0) { %>
                        <div class="table-container">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th><i class="fas fa-user"></i> Name</th>
                                        <th><i class="fas fa-envelope"></i> Email</th>
                                        <th><i class="fas fa-phone"></i> Phone</th>
                                        <th><i class="fas fa-map-marker-alt"></i> City</th>
                                        <th><i class="fas fa-cogs"></i> Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% allAdmin.forEach(adminUser => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-center gap-2">
                                                <% if (adminUser.profile && adminUser.profile !== 'null' && adminUser.profile !== '') { %>
                                                    <img src="/uploads/admin/<%= adminUser.profile %>" 
     alt="Profile" 
     class="profile-img">

                                                <% } else { %>
                                                    <div class="user-avatar" style="width: 32px; height: 32px; font-size: 0.875rem;">
                                                        <%= adminUser.fname.charAt(0).toUpperCase() %>
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <div style="font-weight: 500;"><%= adminUser.fname %> <%= adminUser.lname %></div>
                                                    <div style="font-size: 0.75rem; color: var(--text-secondary);">Administrator</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><%= adminUser.email %></td>
                                        <td><%= adminUser.phone || 'N/A' %></td>
                                        <td><%= adminUser.city || 'N/A' %></td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="/editAdmin/<%= adminUser._id %>" class="btn btn-outline" style="padding: 0.5rem;">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/deleteAdmin/<%= adminUser._id %>" class="btn btn-danger" style="padding: 0.5rem;" 
                                                   onclick="confirmDelete('<%= adminUser._id %>', '<%= adminUser.fname %> <%= adminUser.lname %>')">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center" style="padding: 3rem;">
                            <i class="fas fa-users" style="font-size: 3rem; color: var(--text-secondary); margin-bottom: 1rem;"></i>
                            <h3 style="color: var(--text-secondary); margin-bottom: 0.5rem;">No Admins Found</h3>
                            <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">There are no other administrators in the system.</p>
                            <a href="/addAdmin" class="btn btn-primary">
                                <i class="fas fa-user-plus"></i> Add First Admin
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/js/admin.js"></script>
    
    <% if (typeof flash !== 'undefined') { %>
        <% if (flash.success && flash.success.length > 0) { %>
            <script>
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: '<%= flash.success[0] %>',
                    timer: 3000,
                    showConfirmButton: false
                });
            </script>
        <% } %>
        <% if (flash.error && flash.error.length > 0) { %>
            <script>
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: '<%= flash.error[0] %>',
                    timer: 3000,
                    showConfirmButton: false
                });
            </script>
        <% } %>
    <% } %>
    
    <script>
        if (window.innerWidth <= 768) {
            document.getElementById('sidebarToggle').style.display = 'inline-flex';
        }
        
        window.addEventListener('resize', function() {
            if (window.innerWidth <= 768) {
                document.getElementById('sidebarToggle').style.display = 'inline-flex';
            } else {
                document.getElementById('sidebarToggle').style.display = 'none';
                document.querySelector('.sidebar').classList.remove('active');
            }
        });
        
        function confirmDelete(adminId, adminName) {
            Swal.fire({
                title: 'Are you sure?',
                text: `You want to delete ${adminName}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/deleteAdmin/${adminId}`;
                }
            });
        }
    </script>
</body>
</html>