<%- include('../items/partials/header', { title: 'View Extra Categories' }) %>

<%- include('../items/partials/sidebar') %>

<!-- Main Content -->
<div class="main-content">
    <%- include('../items/partials/topbar', { pageTitle: 'All Extra Categories' }) %>
    
    <!-- Content -->
    <div class="content">
        <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h3>All Extra Categories</h3>
                <a href="/addExtracategory" class="btn btn-primary">+ Add New Extra Category</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Subcategory</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (extracategories.length > 0) { %>
                                <% extracategories.forEach((extra, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td>
                                            <% if (extra.image) { %>
                                                <img src="/uploads/extracategory/<%= extra.image %>" alt="<%= extra.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;">
                                            <% } else { %>
                                                <span>No Image</span>
                                            <% } %>
                                        </td>
                                        <td><%= extra.name %></td>
                                        <td><%= extra.categoryId ? extra.categoryId.name : 'N/A' %></td>
                                        <td><%= extra.subcategoryId ? extra.subcategoryId.name : 'N/A' %></td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="/editExtracategory/<%= extra._id %>" class="btn btn-warning btn-sm">Edit</a>
                                                <a href="/deleteExtracategory/<%= extra._id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center;">No extra categories found</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../items/partials/footer') %>
