<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Admin Panel</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-shield-alt"></i> Admin Panel</h2>
        </div>
        <nav class="sidebar-menu">
            <div style="padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                Pages
            </div>
            <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a href="/profile" class="<%= currentPath === '/profile' ? 'active' : '' %>">
                <i class="fas fa-user"></i> Profile
            </a>
            <a href="/viewAdmin" class="<%= currentPath === '/viewAdmin' ? 'active' : '' %>">
                <i class="fas fa-users"></i> Manage Admins
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                Tools & Components
            </div>
            <a href="/addAdmin" class="<%= currentPath === '/addAdmin' ? 'active' : '' %>">
                <i class="fas fa-user-plus"></i> Add Admin
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                Categories
            </div>
            <a href="/addCategory" class="<%= currentPath === '/addCategory' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Categories
            </a>
            <a href="/viewCategories" class="<%= currentPath === '/viewCategories' || currentPath.includes('/editCategory') ? 'active' : '' %>">
                <i class="fas fa-list"></i> All Categories
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                Sub Categories
            </div>
            <a href="/addSubcategory" class="<%= currentPath === '/addSubcategory' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Sub Categories
            </a>
            <a href="/viewSubcategories" class="<%= currentPath === '/viewSubcategories' || currentPath.includes('/editSubcategory') ? 'active' : '' %>">
                <i class="fas fa-folder"></i> All Sub Categories
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                Extra Categories
            </div>
            <a href="/addExtracategory" class="<%= currentPath === '/addExtracategory' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Extra Categories
            </a>
            <a href="/viewExtracategories" class="<%= currentPath === '/viewExtracategories' || currentPath.includes('/editExtracategory') ? 'active' : '' %>">
                <i class="fas fa-layer-group"></i> All Extra Categories
            </a>
            
            <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                Products
            </div>
            <a href="/addProduct" class="<%= currentPath === '/addProduct' ? 'active' : '' %>">
                <i class="fas fa-plus-circle"></i> Add Product
            </a>
            <a href="/viewProducts" class="<%= currentPath === '/viewProducts' || currentPath.includes('/editProduct') ? 'active' : '' %>">
                <i class="fas fa-box"></i> All Products
            </a>
            
            <a href="/change-password" class="<%= currentPath === '/change-password' ? 'active' : '' %>" style="margin-top: 1rem;">
                <i class="fas fa-key"></i> Change Password
            </a>
            <a href="/logout" style="margin-top: 1rem; color: #ef4444;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <div class="header-left">
                <button id="sidebarToggle" class="btn btn-outline" style="display: none; margin-right: 1rem;">
                    <i class="fas fa-bars"></i>
                </button>
                <h1>Dashboard</h1>
            </div>
            <div class="header-right">
                <div class="user-info">
                    <div class="user-avatar">
                        <% if (admin && admin.fname) { %>
                            <%= admin.fname.charAt(0).toUpperCase() %>
                        <% } else { %>
                            A
                        <% } %>
                    </div>
                    <div>
                        <div style="font-weight: 600;">
                            <% if (admin && admin.fname && admin.lname) { %>
                                <%= admin.fname %> <%= admin.lname %>
                            <% } else { %>
                                Admin User
                            <% } %>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-secondary);">Administrator</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Content -->
        <div class="content">
            <!-- Welcome Section -->
            <div class="card mb-3">
                <div class="card-body">
                    <h2 style="margin-bottom: 0.5rem;">
                        Welcome back, 
                        <% if (admin && admin.fname) { %>
                            <%= admin.fname %>
                        <% } else { %>
                            Admin
                        <% } %>! 👋
                    </h2>
                    <p style="color: var(--text-secondary); margin: 0;">Here's what's happening with your admin panel today.</p>
                </div>
            </div>
            
            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-title">Total Admins</div>
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                    <div class="stat-value"><%= totalAdmins %></div>
                </div>
                
                <div class="stat-card success">
                    <div class="stat-header">
                        <div class="stat-title">Total Categories</div>
                        <div class="stat-icon" style="background: var(--success-color);">
                            <i class="fas fa-folder"></i>
                        </div>
                    </div>
                    <div class="stat-value"><%= totalCategories %></div>
                </div>
                
                <div class="stat-card warning">
                    <div class="stat-header">
                        <div class="stat-title">Sub Categories</div>
                        <div class="stat-icon" style="background: var(--warning-color);">
                            <i class="fas fa-folder-open"></i>
                        </div>
                    </div>
                    <div class="stat-value"><%= totalSubcategories %></div>
                </div>
                
                <div class="stat-card danger">
                    <div class="stat-header">
                        <div class="stat-title">Extra Categories</div>
                        <div class="stat-icon" style="background: var(--danger-color);">
                            <i class="fas fa-layer-group"></i>
                        </div>
                    </div>
                    <div class="stat-value"><%= totalExtracategories %></div>
                </div>
                
                <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="stat-header">
                        <div class="stat-title" style="color: white;">Total Products</div>
                        <div class="stat-icon" style="background: rgba(255,255,255,0.3);">
                            <i class="fas fa-box" style="color: white;"></i>
                        </div>
                    </div>
                    <div class="stat-value" style="color: white;"><%= totalProducts %></div>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="card">
                <div class="card-header">
                    <h3>Quick Actions</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2" style="flex-wrap: wrap;">
                        <a href="/addAdmin" class="btn btn-primary">
                            <i class="fas fa-user-plus"></i> Add New Admin
                        </a>
                        <a href="/viewAdmin" class="btn btn-outline">
                            <i class="fas fa-list"></i> View All Admins
                        </a>
                        <a href="/profile" class="btn btn-outline">
                            <i class="fas fa-user-edit"></i> Edit Profile
                        </a>
                        <a href="/change-password" class="btn btn-outline">
                            <i class="fas fa-key"></i> Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/js/admin.js"></script>
    
    <% if (typeof flash !== 'undefined') { %>
        <% if (flash.success && flash.success.length > 0) { %>
            <script>
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: '<%= flash.success[0] %>',
                    timer: 3000,
                    showConfirmButton: false
                });
            </script>
        <% } %>
        <% if (flash.error && flash.error.length > 0) { %>
            <script>
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: '<%= flash.error[0] %>',
                    timer: 3000,
                    showConfirmButton: false
                });
            </script>
        <% } %>
    <% } %>
    
    <script>
        // Show mobile menu button on small screens
        if (window.innerWidth <= 768) {
            document.getElementById('sidebarToggle').style.display = 'inline-flex';
        }
        
        window.addEventListener('resize', function() {
            if (window.innerWidth <= 768) {
                document.getElementById('sidebarToggle').style.display = 'inline-flex';
            } else {
                document.getElementById('sidebarToggle').style.display = 'none';
                document.querySelector('.sidebar').classList.remove('active');
            }
        });
    </script>
</body>
</html>