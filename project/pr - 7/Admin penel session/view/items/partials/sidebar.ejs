            <i class="fas fa-user-plus"></i> Add Admin
        </a>
        
        <div style="margin-top: 1rem; padding: 0.5rem 1rem; color: #888; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Categories</div>
        <a href="/addCategory" class="<%= currentPath === '/addCategory' ? 'active' : '' %>">
