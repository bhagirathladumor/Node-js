<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password - Admin Panel</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-shield-alt"></i> Admin Panel</h2>
        </div>
        <nav class="sidebar-menu">
            <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a href="/profile" class="<%= currentPath === '/profile' ? 'active' : '' %>">
                <i class="fas fa-user"></i> Profile
            </a>
            <a href="/viewAdmin" class="<%= currentPath === '/viewAdmin' ? 'active' : '' %>">
                <i class="fas fa-users"></i> View Admins
            </a>
            <a href="/addAdmin" class="<%= currentPath === '/addAdmin' ? 'active' : '' %>">
                <i class="fas fa-user-plus"></i> Add Admin
            </a>
            <a href="/change-password" class="<%= currentPath === '/change-password' ? 'active' : '' %>">
                <i class="fas fa-key"></i> Change Password
            </a>
            <a href="/logout" style="margin-top: 2rem; color: #ef4444;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <div class="header-left">
                <button id="sidebarToggle" class="btn btn-outline" style="display: none; margin-right: 1rem;">
                    <i class="fas fa-bars"></i>
                </button>
                <h1>Change Password</h1>
            </div>
            <div class="header-right">
                <div class="user-info">
                    <div class="user-avatar">
                        <%= admin.fname.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                        <div style="font-weight: 600;"><%= admin.fname %> <%= admin.lname %></div>
                        <div style="font-size: 0.75rem; color: var(--text-secondary);">Administrator</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Content -->
        <div class="content">
            <div style="max-width: 500px; margin: 0 auto;">
                <div class="card">
                    <div class="card-header text-center">
                        <div class="user-avatar" style="width: 60px; height: 60px; margin: 0 auto 1rem; font-size: 1.5rem; background: var(--warning-color);">
                            <i class="fas fa-key"></i>
                        </div>
                        <h3>Change Your Password</h3>
                        <p style="color: var(--text-secondary); margin: 0;">Update your account password for better security</p>
                    </div>
                    <div class="card-body">
                        <form action="/change-password" method="POST">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-lock"></i> Current Password
                                </label>
                                <input type="password" name="currentPass" class="form-control" 
                                       placeholder="Enter your current password" required>
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-key"></i> New Password
                                </label>
                                <input type="password" name="newPass" class="form-control" 
                                       placeholder="Enter new password" minlength="6" required>
                                <small style="color: var(--text-secondary); font-size: 0.75rem;">Password must be at least 6 characters long</small>
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-check-circle"></i> Confirm New Password
                                </label>
                                <input type="password" name="ConfPass" class="form-control" 
                                       placeholder="Confirm new password" minlength="6" required>
                                <small id="passwordMatch" style="font-size: 0.75rem;"></small>
                            </div>
                            
                            <div class="d-flex gap-2 mt-3">
                                <button type="submit" class="btn btn-primary" id="submitBtn">
                                    <i class="fas fa-save"></i> Update Password
                                </button>
                                <a href="/dashboard" class="btn btn-outline">
                                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
                
                <!-- Security Tips -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h3><i class="fas fa-shield-alt"></i> Security Tips</h3>
                    </div>
                    <div class="card-body">
                        <ul style="margin: 0; padding-left: 1.5rem; color: var(--text-secondary);">
                            <li>Use a strong password with at least 8 characters</li>
                            <li>Include uppercase, lowercase, numbers, and special characters</li>
                            <li>Don't reuse passwords from other accounts</li>
                            <li>Change your password regularly</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="/js/admin.js"></script>
    <script>
        const newPassInput = document.querySelector('input[name="newPass"]');
        const confPassInput = document.querySelector('input[name="ConfPass"]');
        const passwordMatch = document.getElementById('passwordMatch');
        const submitBtn = document.getElementById('submitBtn');
        
        function checkPasswordMatch() {
            if (confPassInput.value === '') {
                passwordMatch.textContent = '';
                passwordMatch.style.color = '';
                return;
            }
            
            if (newPassInput.value === confPassInput.value) {
                passwordMatch.textContent = '✓ Passwords match';
                passwordMatch.style.color = 'var(--success-color)';
                submitBtn.disabled = false;
            } else {
                passwordMatch.textContent = '✗ Passwords do not match';
                passwordMatch.style.color = 'var(--danger-color)';
                submitBtn.disabled = true;
            }
        }
        
        newPassInput.addEventListener('input', checkPasswordMatch);
        confPassInput.addEventListener('input', checkPasswordMatch);
        
        if (window.innerWidth <= 768) {
            document.getElementById('sidebarToggle').style.display = 'inline-flex';
        }
        
        window.addEventListener('resize', function() {
            if (window.innerWidth <= 768) {
                document.getElementById('sidebarToggle').style.display = 'inline-flex';
            } else {
                document.getElementById('sidebarToggle').style.display = 'none';
                document.querySelector('.sidebar').classList.remove('active');
            }
        });
    </script>
</body>
</html>