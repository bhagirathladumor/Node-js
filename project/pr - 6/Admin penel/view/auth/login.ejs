<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Admin Panel</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <div class="user-avatar" style="width: 60px; height: 60px; margin: 0 auto 1rem; font-size: 1.5rem;">
                    <i class="fas fa-user-shield"></i>
                </div>
                <h2>Admin Login</h2>
                <p>Welcome back! Please sign in to your account</p>
            </div>
            
            <% if (typeof success !== 'undefined' && success) { %>
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; text-align: center;">
                    <i class="fas fa-check-circle"></i> <%= success %>
                </div>
            <% } %>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; text-align: center;">
                    <i class="fas fa-exclamation-triangle"></i> <%= error %>
                </div>
            <% } %>
            
            <form action="/login" method="POST">
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <input type="email" name="email" class="form-control" placeholder="Enter your email" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-lock"></i> Password
                    </label>
                    <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
                </div>
                
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-bottom: 1rem;">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </button>
            </form>
            
            <div style="text-align: center; margin: 1.5rem 0; color: var(--text-secondary);">
                <span>Forgot your password?</span>
            </div>
            
            <form action="/verify-email" method="POST">
                <div class="form-group">
                    <input type="email" name="email" class="form-control" placeholder="Enter email for password reset" required>
                </div>
                <button type="submit" class="btn btn-outline" style="width: 100%;">
                    <i class="fas fa-paper-plane"></i> Send Reset OTP
                </button>
            </form>
            
            <div style="text-align: center; margin-top: 2rem; font-size: 0.875rem; color: var(--text-secondary);">
                © 2024 Admin Panel. All rights reserved.
            </div>
        </div>
    </div>
    
    <script src="/js/admin.js"></script>
</body>
</html>